# GNOME Shell 45, as shipped by Ubuntu 23.10.
FROM ubuntu:23.10

ENV DEBIAN_FRONTEND=noninteractive
# Ubuntu 23.10 has reached end of life, so its archive lives on old-releases.
RUN sed -i -e 's|archive.ubuntu.com|old-releases.ubuntu.com|g' \
           -e 's|security.ubuntu.com|old-releases.ubuntu.com|g' \
           -e 's|ports.ubuntu.com|old-releases.ubuntu.com|g' /etc/apt/sources.list
RUN apt-get update && apt-get install -y --no-install-recommends \
      gnome-shell gjs libglib2.0-bin libsoup-3.0-0 \
      dbus dbus-x11 python3-dbusmock \
      libgl1-mesa-dri gsettings-desktop-schemas locales procps \
 && rm -rf /var/lib/apt/lists/*

# Ubuntu ships a placeholder account on uid 1000.
RUN userdel -r ubuntu 2>/dev/null || true; useradd -u 1000 -m tester
ENV LANG=C.UTF-8
USER tester
WORKDIR /home/tester
