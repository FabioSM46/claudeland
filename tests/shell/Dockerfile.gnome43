# GNOME Shell 43, as shipped by Debian 12 (bookworm).
FROM debian:12

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      gnome-shell gjs libglib2.0-bin libsoup-3.0-0 gir1.2-soup-3.0 \
      dbus dbus-x11 python3-dbusmock \
      libgl1-mesa-dri gsettings-desktop-schemas locales procps \
 && rm -rf /var/lib/apt/lists/*

RUN useradd -u 1000 -m tester
ENV LANG=C.UTF-8
USER tester
WORKDIR /home/tester
