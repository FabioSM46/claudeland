# GNOME Shell 42, as shipped by Ubuntu 22.04 LTS.
#
# This image deliberately installs no libsoup 3 introspection data: Ubuntu 22.04
# ships only gir1.2-soup-2.4 by default, so the run exercises the libsoup 2.4
# fallback in src/services/soup-transport.ts.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      gnome-shell gjs libglib2.0-bin gir1.2-soup-2.4 \
      dbus dbus-x11 python3-dbusmock \
      libgl1-mesa-dri gsettings-desktop-schemas locales procps \
 && rm -rf /var/lib/apt/lists/*

RUN useradd -u 1000 -m tester
ENV LANG=C.UTF-8
USER tester
WORKDIR /home/tester
