# GNOME Shell 48, as shipped by Ubuntu 25.04.
FROM ubuntu:25.04

ENV DEBIAN_FRONTEND=noninteractive
# When Ubuntu 25.04 leaves the main archive, point these sources at
# old-releases.ubuntu.com, as tests/shell/Dockerfile.gnome45 already does.
RUN apt-get update && apt-get install -y --no-install-recommends \
      gnome-shell gjs libglib2.0-bin libsoup-3.0-0 \
      dbus dbus-x11 python3-dbusmock \
      libgl1-mesa-dri gsettings-desktop-schemas locales procps \
 && rm -rf /var/lib/apt/lists/*

# Ubuntu ships a placeholder account on uid 1000.
RUN userdel -r ubuntu 2>/dev/null || true; useradd -u 1000 -m tester
ENV LANG=C.UTF-8
USER tester
WORKDIR /home/tester
