{
  "name": "claudeland",
  "version": "0.1.0",
  "description": "GNOME Shell extension for remaining Claude plan usage on Ubuntu Wayland",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "FabioSM46",
  "engines": {
    "node": ">=20.19",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "clean": "node scripts/clean.mjs",
    "dev:install": "node scripts/install.mjs",
    "lint": "eslint .",
    "package": "pnpm build && node scripts/pack.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:gjs": "gjs -m dist/smoke-test.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@girs/adw-1": "4.2.0",
    "@girs/gjs": "4.2.0",
    "@girs/gnome-shell": "50.0.4",
    "@girs/gobject-2.0": "4.2.0",
    "@girs/gtk-4.0": "4.2.0",
    "@girs/soup-3.0": "4.2.0",
    "@types/node": "^24.3.0",
    "eslint": "^10.9.1",
    "gettext-parser": "^9.1.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^4.1.11"
  }
}
